<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageTags>repository;manager;entitymanager;events;domain-events;cloudevents</PackageTags>
    <Description>Extends the Entity Manager with a framework-agnostic domain event model, publishing lifecycle events through the operation pipeline</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Deveel.Results" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kista.Manager\Kista.Manager.csproj" />
  </ItemGroup>

</Project>