<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageTags>repository;manager;entitymanager;events;domain-events;cloudevents;hermodr</PackageTags>
    <Description>Adapter that bridges the Entity Manager domain event model with the Hermodr CloudEvents framework, dispatching canonical CNCF CloudEvents through Hermodr's publisher pipeline</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hermodr.Publisher" />
    <PackageReference Include="Hermodr.Subscriptions" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kista.Manager.Events\Kista.Manager.Events.csproj" />
  </ItemGroup>

</Project>